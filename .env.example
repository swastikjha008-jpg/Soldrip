# ------------------------------------------------------------------
# SOLDRIP environment variables
# Copy this file to .env and fill in the values you need.
# Every value here is safe to expose to the client (Vite only exposes
# variables prefixed with VITE_) — never put secret keys in this file
# or in any VITE_ variable.
# ------------------------------------------------------------------

# Solana RPC endpoint used for balance reads and airdrop requests.
# Defaults to clusterApiUrl("devnet") if not set. Set this to a
# dedicated Devnet RPC (Helius, QuickNode, Alchemy, etc.) if you hit
# public RPC rate limits.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Explorer cluster query param appended to transaction links.
VITE_EXPLORER_CLUSTER=devnet

# Maximum SOL a single airdrop request is allowed to claim.
VITE_MAX_AIRDROP_SOL=2

# Cooldown (in seconds) a wallet must wait between successful claims.
VITE_COOLDOWN_SECONDS=60

# Path (relative to /public) to the source image the ASCII background
# renderer samples. Leave unset to use the built-in procedural texture
# (default) — no external image required. If set and the file is
# missing or fails to load, SOLDRIP falls back to the procedural
# texture automatically.
# VITE_ASCII_SOURCE_IMAGE=/assets/ascii-source.jpg
